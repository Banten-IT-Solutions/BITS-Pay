{
  "name": "bits-pay",
  "version": "0.1.0",
  "description": "QRIS payment gateway untuk aplikasi kamu",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w packages/api",
    "dev:web": "npm run dev -w packages/web",
    "dev:setup": "node scripts/setup-local.mjs",
    "dev:all:run": "concurrently -k -n api,web,user,admin -c blue,green,yellow,magenta \"npm run dev -w packages/api -- --local --port 5173 --ip 0.0.0.0\" \"npm run dev -w packages/web -- --host 0.0.0.0 --port 5174 --strictPort\" \"npm run dev -w packages/user -- --host 0.0.0.0 --port 5175 --strictPort\" \"npm run dev -w packages/admin -- --host 0.0.0.0 --port 5176 --strictPort\"",
    "dev:all": "npm run dev:setup && npm run dev:all:run",
    "build": "npm run build -w packages/shared && npm run build -w packages/api",
    "build:all": "npm run build && npm run build -w packages/web && npm run build -w packages/user && npm run build -w packages/admin",
    "lint": "eslint --no-error-on-unmatched-pattern --pass-on-no-patterns packages/api/src packages/shared/src",
    "lint:fix": "eslint --fix --no-error-on-unmatched-pattern --pass-on-no-patterns packages/api/src packages/shared/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "deploy:api": "wrangler deploy --config packages/api/wrangler.jsonc",
    "deploy:web": "wrangler deploy --config packages/web/wrangler.jsonc"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "concurrently": "10.0.5",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
