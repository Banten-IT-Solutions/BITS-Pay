# ============================================================
# BITS Pay — Environment Variables Template
# Copy ke .env atau .dev.vars untuk local development
# ============================================================

# ── Cloudflare D1 ──
# Database ID dari: wrangler d1 create bits-pay-db
# Untuk local: biarkan kosong (wrangler dev pake SQLite local)
DB=database_id_here

# ── Cloudflare R2 ──
# Bucket untuk bukti bayar
R2=bucket_name_here

# ── Cloudflare Queue ──
CALLBACK_QUEUE=payment-callback

# ── Cloudflare Email Service ──
# Domain harus diverifikasi di Cloudflare Email Routing
FROM_EMAIL=noreply@pay.bits.co.id

# ── App URLs ──
APP_URL=https://pay.bits.co.id
API_URL=https://api.pay.bits.co.id

# ── QRIS ──
# QRIS static string dari merchant. Contoh:
# "00020101021126640012ID.CO.BITS.WWW011893600912000080802..."
QRIS_STATIC=

# ── Transaksi ──
TRANSACTION_EXPIRE_MINUTES=15
MAX_UNIQUE_CODE=9999
PROOF_RETENTION_DAYS=30

# ── JWT ──
# Generate: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d

# ── Google OAuth ──
# Dapatkan dari Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_REDIRECT_URI=https://pay.bits.co.id/auth/google/callback

# ── OCR ──
OCR_CONFIDENCE_THRESHOLD=85
# OCR_PROVIDER: workers-ai | tesseract-vps
OCR_PROVIDER=workers-ai

# ── Billing / Premium ──
PREMIUM_PRICE_MONTHLY=50000
PREMIUM_PRICE_YEARLY=500000