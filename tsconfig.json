{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@bits-pay/shared": ["./packages/shared/src/index.ts"]
    }
  },
  "include": ["packages/api/src", "packages/shared/src", "tests"],
  "exclude": ["node_modules", "dist", ".wrangler"]
}
